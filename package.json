{
  "name": "tavli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "vite build --ssr server/serve.ts --outDir dist-server",
    "start": "node dist-server/serve.js"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "Tavli (Greek backgammon) played against Jev, TypeSafe's System One decision model."
}